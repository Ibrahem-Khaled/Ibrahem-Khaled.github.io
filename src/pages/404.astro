---
import Base from '../layouts/Base.astro'
import { PROFILE } from '../data/profile'
import { withBase } from '../utils/paths'
---

<Base
  lang="en"
  title={`Page Not Found — ${PROFILE.name.en}`}
  description="The requested page could not be found."
>
  <section class="container-swiss py-24">
    <p class="meta-label">Error 404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink">Page not found</h1>
    <p class="mt-3 max-w-md text-sm text-ink-soft">
      The link may have moved during the 2026 portfolio rebuild. Use the links below to continue.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={withBase('/')} class="btn-primary">Go Home →</a>
      <a href={withBase('/work/')} class="btn-secondary">View Case Studies</a>
    </div>
  </section>
</Base>
