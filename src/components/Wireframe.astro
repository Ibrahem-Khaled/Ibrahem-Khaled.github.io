---
interface Props {
  variant: 'qwen-pipeline' | 'tenant-console'
  caption: string
}

const { variant, caption } = Astro.props
---

<figure class="my-8 border border-rule bg-paper-alt p-4 sm:p-6" dir="ltr">
  <div class="mb-4 flex items-center justify-between border-b border-rule pb-2.5 font-mono text-[11px] uppercase tracking-wider text-ink-muted">
    <span>Abstract Interface Wireframe · NDA Redacted</span>
    <span>Schematic View</span>
  </div>

  {variant === 'qwen-pipeline' ? (
    <div class="grid gap-4 border border-rule bg-paper p-4 sm:grid-cols-12">
      <div class="space-y-3 border-b border-rule pb-4 sm:col-span-7 sm:border-b-0 sm:border-e sm:pb-0 sm:pe-4">
        <div class="flex items-center justify-between font-mono text-[11px] text-ink-muted">
          <span>LESSON STAGE · SYNCED VISUAL</span>
          <span class="text-accent">STREAMING</span>
        </div>
        <div class="grid h-36 place-items-center border border-dashed border-rule bg-paper-alt p-4 text-center font-mono text-xs text-ink-muted">
          [ Slide / Formula Canvas Synced to Audio Timestamps ]
        </div>
        <div class="flex items-center gap-3">
          <span class="inline-block h-2.5 w-2.5 bg-accent"></span>
          <div class="h-1.5 flex-1 bg-rule">
            <div class="h-full w-2/3 bg-ink"></div>
          </div>
          <span class="font-mono text-[11px] text-ink-muted">01:42 / 02:30</span>
        </div>
      </div>

      <div class="space-y-2.5 sm:col-span-5">
        <div class="font-mono text-[11px] text-ink-muted">INFERENCE TELEMETRY</div>
        <div class="border border-rule bg-paper-alt p-2.5 font-mono text-[11px]">
          <div class="flex justify-between"><span>Model</span><span class="font-semibold">qwen-finetuned</span></div>
          <div class="mt-1 flex justify-between"><span>Cache</span><span class="text-accent">Redis Semantic Hit</span></div>
          <div class="mt-1 flex justify-between"><span>Transport</span><span>SSE Chunked</span></div>
          <div class="mt-1 flex justify-between"><span>Fallback</span><span>Armed (Closed)</span></div>
        </div>
        <div class="border border-rule p-2.5 font-mono text-[11px] text-ink-muted">
          Chunked Arabic explanation segments emitted with step-marker metadata for zero-drift audio/slide sync.
        </div>
      </div>
    </div>
  ) : (
    <div class="grid gap-4 border border-rule bg-paper p-4 sm:grid-cols-12">
      <div class="space-y-2 border-b border-rule pb-4 sm:col-span-4 sm:border-b-0 sm:border-e sm:pb-0 sm:pe-4 font-mono text-[11px]">
        <div class="text-ink-muted">TENANT CONTEXT</div>
        <div class="border border-accent bg-accent-tint px-2.5 py-1.5 text-accent-dark">
          tenant_station_04.app
        </div>
        <div class="space-y-1 pt-2 text-ink-soft">
          <div class="border-b border-rule py-1">01 · Shift Reconciliation</div>
          <div class="border-b border-rule py-1">02 · Tank &amp; Pump Readings</div>
          <div class="border-b border-rule py-1">03 · Fleet Credit Accounts</div>
          <div class="py-1">04 · Isolated Audit Log</div>
        </div>
      </div>
      <div class="space-y-3 sm:col-span-8 font-mono text-[11px]">
        <div class="flex items-center justify-between text-ink-muted">
          <span>ACTIVE SHIFT · PUMP METER LEDGER</span>
          <span>DB: tenant_04 (ISOLATED)</span>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div class="border border-rule bg-paper-alt p-2.5">
            <div class="text-ink-muted">OPEN METER</div>
            <div class="mt-1 text-sm font-semibold text-ink">142,880 L</div>
          </div>
          <div class="border border-rule bg-paper-alt p-2.5">
            <div class="text-ink-muted">CLOSE METER</div>
            <div class="mt-1 text-sm font-semibold text-ink">149,310 L</div>
          </div>
          <div class="border border-rule bg-paper-alt p-2.5">
            <div class="text-ink-muted">VARIANCE</div>
            <div class="mt-1 text-sm font-semibold text-accent">0.00% OK</div>
          </div>
        </div>
        <div class="border border-dashed border-rule p-2.5 text-ink-muted">
          Row-level locking prevents concurrent shift closure while tenant-scoped queues dispatch invoicing &amp; ERP exports.
        </div>
      </div>
    </div>
  )}

  <figcaption class="mt-3 border-t border-rule pt-2.5 font-mono text-xs text-ink-muted">
    {caption}
  </figcaption>
</figure>
