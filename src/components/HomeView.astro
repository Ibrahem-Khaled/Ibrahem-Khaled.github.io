---
import { getCollection } from 'astro:content'
import DeviceFrame from './DeviceFrame.astro'
import ArchDiagram from './diagrams/ArchDiagram.astro'
import {
  CLIENT_QUOTES,
  HERO_FACTS,
  OPEN_SOURCE_REPOS,
  PRINCIPLES,
  PROFILE,
  SHIPPED_SHOWCASE,
  STACK_GROUPS,
  WORK_INDEX,
} from '../data/profile'
import { withBase, type Locale } from '../utils/paths'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const prefix = lang === 'ar' ? '/ar' : ''

// Pull EN studies as canonical order; prefer localized Arabic study when available
const allWork = await getCollection('work')
const enStudies = allWork
  .filter((e) => e.data.lang === 'en')
  .sort((a, b) => a.data.order - b.data.order)
const arBySlug = new Map(
  allWork.filter((e) => e.data.lang === 'ar').map((e) => [e.data.routeSlug, e]),
)

const featuredStudies = enStudies.map((enEntry) => {
  if (lang === 'ar') {
    const arMatch = arBySlug.get(enEntry.data.routeSlug)
    if (arMatch) return { entry: arMatch, href: `${prefix}/work/${arMatch.data.routeSlug}/`, isArabic: true }
    // English-only technical deep-dive still accessible directly
    return { entry: enEntry, href: `/work/${enEntry.data.routeSlug}/`, isArabic: false }
  }
  return { entry: enEntry, href: `/work/${enEntry.data.routeSlug}/`, isArabic: false }
})

const arrow = lang === 'en' ? '→' : '←'
---

<!-- ══ HERO ══════════════════════════════════════════════════════════════════ -->
<section class="container-swiss pt-12 pb-16 md:pt-20 md:pb-20">
  <div class="grid items-start gap-12 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-ink-muted">
        <span class="inline-flex items-center gap-2 text-ink">
          <span class="h-2 w-2 rounded-full bg-accent"></span>
          {PROFILE.availability[lang]}
        </span>
        <span aria-hidden="true">·</span>
        <span>{PROFILE.location[lang]}</span>
      </div>

      <h1
        class:list={[
          'mt-6 text-3xl font-semibold tracking-tight text-ink sm:text-5xl',
          lang === 'ar'
            ? 'lg:text-[3.1rem] lg:leading-[1.28]'
            : 'lg:text-[3.35rem] lg:leading-[1.08]',
        ]}
      >
        {PROFILE.positioning[lang]}
      </h1>

      <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
        {PROFILE.summary[lang]}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3.5">
        <a href="#selected-work" class="btn-primary">
          {lang === 'en' ? 'Selected Case Studies' : 'دراسات الحالة والمشاريع'} ↓
        </a>
        <a href={withBase(`${prefix}/hire/`)} class="btn-secondary">
          {lang === 'en' ? 'Hire / Engage' : 'تعاقد على مشروع'} {arrow}
        </a>
        <a
          href={withBase(PROFILE.cvPath)}
          download="Ibrahim_Khaled_CV.pdf"
          class="btn-quiet ms-1"
        >
          {lang === 'en' ? 'Download CV (PDF) ↓' : 'تحميل السيرة الذاتية (PDF) ↓'}
        </a>
      </div>
    </div>

    <!-- Real editorial portrait (replaces generic AI headshot / fake terminal) -->
    <div class="lg:col-span-4">
      <figure class="mx-auto max-w-xs border border-ink bg-paper-alt p-2 lg:ms-auto lg:me-0">
        <img
          src={withBase('/images/team/ibrahim-khaled.webp')}
          alt={PROFILE.name[lang]}
          width={640}
          height={800}
          loading="eager"
          decoding="async"
          class="block aspect-4/5 w-full object-cover"
        />
        <figcaption class="flex items-center justify-between px-1 pt-2 font-mono text-[11px] text-ink-muted" dir="ltr">
          <span>{PROFILE.name.en}</span>
          <span>EGY · UTC+2</span>
        </figcaption>
      </figure>
    </div>
  </div>

  <!-- Evidence Strip (Real numbers only, zero animated counters) -->
  <dl class="mt-14 grid grid-cols-2 gap-6 border-y border-ink py-6 md:grid-cols-4">
    {HERO_FACTS.map((fact) => (
      <div class="min-w-0">
        <dt class="meta-label">{fact.label[lang]}</dt>
        <dd class="tabular-nums mt-2 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
          {fact.value[lang]}
        </dd>
        <dd class="mt-1 text-xs text-ink-muted">{fact.detail[lang]}</dd>
      </div>
    ))}
  </dl>
</section>

<!-- ══ 01 · SELECTED CASE STUDIES ═══════════════════════════════════════════ -->
<section id="selected-work" class="container-swiss py-14 md:py-20">
  <div class="flex flex-wrap items-end justify-between gap-4 border-b border-ink pb-5">
    <div>
      <p class="meta-label">01 / {lang === 'en' ? 'Engineering Case Studies' : 'دراسات حالة هندسية'}</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {lang === 'en' ? 'Selected Production Work' : 'أبرز الأنظمة الإنتاجية'}
      </h2>
    </div>
    <a href={withBase(`${prefix}/work/`)} class="btn-quiet">
      {lang === 'en' ? 'View full index (15 systems)' : 'عرض الفهرس الكامل (15 نظاماً)'} {arrow}
    </a>
  </div>

  <div class="divide-y divide-rule">
    {featuredStudies.map(({ entry, href, isArabic }, index) => {
      const d = entry.data
      const num = String(index + 1).padStart(2, '0')
      return (
        <article class="grid gap-8 py-12 lg:grid-cols-12 lg:items-start">
          <!-- Copy Column -->
          <div class="min-w-0 lg:col-span-5">
            <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-ink-muted">
              <span class="font-semibold text-accent">{num}</span>
              <span>·</span>
              <span>{d.year}</span>
              <span>·</span>
              <span>{d.domain}</span>
              {d.status === 'in-progress' && (
                <span class="chip chip-accent">
                  {lang === 'en' ? 'In Progress' : 'قيد التطوير'}
                </span>
              )}
              {d.nda && (
                <span class="chip">NDA</span>
              )}
            </div>

            <h3 class="mt-3 text-2xl font-semibold tracking-tight text-ink leading-snug">
              <a href={withBase(href)} class="transition-colors hover:text-accent">
                {d.title}
              </a>
            </h3>

            <p class="mt-3 text-sm leading-relaxed text-ink-soft sm:text-base">
              {d.summary}
            </p>

            <!-- Headline Metric -->
            <div class="mt-5 border-s-2 border-accent bg-paper-alt px-4 py-3">
              <p class="tabular-nums text-lg font-semibold text-ink">{d.headlineMetric.value}</p>
              <p class="text-xs text-ink-muted">{d.headlineMetric.label}</p>
            </div>

            <!-- Stack -->
            <div class="mt-5 flex flex-wrap gap-1.5">
              {d.stack.map((tech) => (
                <span class="chip">{tech}</span>
              ))}
            </div>

            <!-- Links -->
            <div class="mt-6 flex flex-wrap items-center gap-5">
              <a href={withBase(href)} class="btn-primary">
                {lang === 'en'
                  ? 'Read Architecture Study'
                  : isArabic
                    ? 'قراءة الدراسة الهندسية'
                    : 'قراءة الدراسة (EN)'}{' '}
                {arrow}
              </a>
              {d.liveUrl && (
                <a href={d.liveUrl} target="_blank" rel="noopener noreferrer" class="btn-quiet">
                  {lang === 'en' ? 'Live Site ↗' : 'الموقع الحي ↗'}
                </a>
              )}
              {d.playStoreUrl && (
                <a href={d.playStoreUrl} target="_blank" rel="noopener noreferrer" class="btn-quiet">
                  Google Play ↗
                </a>
              )}
            </div>
          </div>

          <!-- Visual Proof Column -->
          <div class="min-w-0 lg:col-span-7">
            {d.coverImage ? (
              <a href={withBase(href)} class="block transition-opacity hover:opacity-95" aria-label={d.title}>
                <DeviceFrame
                  src={d.coverImage.src}
                  alt={d.coverImage.alt}
                  width={d.coverImage.width}
                  height={d.coverImage.height}
                  urlLabel={d.coverImage.urlLabel}
                  figureLabel={`CASE ${num} — ${d.liveUrl ? 'LIVE PRODUCTION CAPTURE' : 'SYSTEM VIEW'}`}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </a>
            ) : d.diagramVariant ? (
              <a href={withBase(href)} class="block transition-opacity hover:opacity-95" aria-label={d.title}>
                <ArchDiagram
                  variant={d.diagramVariant}
                  caption={
                    lang === 'en'
                      ? `CASE ${num} — NDA architecture schematic. Click to read trade-offs & code excerpt.`
                      : `دراسة ${num} — مخطط معماري لنظام تحت NDA. اضغط لقراءة المقايضات ومقتطفات الكود.`
                  }
                />
              </a>
            ) : null}
          </div>
        </article>
      )
    })}
  </div>
</section>

<!-- ══ 02 · LIVE WEB & GOOGLE PLAY RELEASES ═════════════════════════════════ -->
<section class="border-y border-rule bg-paper-alt/55 py-16 md:py-20">
  <div class="container-swiss">
    <div class="border-b border-ink pb-5">
      <p class="meta-label">02 / {lang === 'en' ? 'Verified Public Releases' : 'إطلاقات حية وموثقة'}</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {lang === 'en' ? 'More Shipped Web & Google Play Products' : 'مشاريع ويب وتطبيقات إضافية على Google Play'}
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-ink-muted">
        {lang === 'en'
          ? 'Real production builds published with client permission — where I served as the sole responsible full-stack and mobile engineer.'
          : 'منتجات فعلية منشورة بإذن أصحابها — توليت فيها البرمجة والمسؤولية التقنية الكاملة من البداية حتى النشر.'}
      </p>
    </div>

    <div class="mt-10 space-y-12">
      {SHIPPED_SHOWCASE.map((item) => (
        <article class="grid gap-8 border-b border-rule pb-12 last:border-b-0 last:pb-0 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-5">
            <p class="meta-label">{item.year} · {item.kind[lang]}</p>
            <h3 class="mt-2 text-xl font-semibold tracking-tight text-ink sm:text-2xl">
              {item.name[lang]}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">
              {item.summary[lang]}
            </p>
            <p class="mt-4 font-mono text-xs font-medium text-accent">
              {item.metric[lang]}
            </p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {item.stack.map((tech) => (
                <span class="chip">{tech}</span>
              ))}
            </div>
            <div class="mt-6 flex flex-wrap gap-4">
              {item.liveUrl && (
                <a href={item.liveUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                  {lang === 'en' ? 'Open Live Platform ↗' : 'فتح المنصة الحية ↗'}
                </a>
              )}
              {item.playStoreUrl && (
                <a href={item.playStoreUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                  {lang === 'en' ? 'View on Google Play ↗' : 'عرض على Google Play ↗'}
                </a>
              )}
            </div>
          </div>

          <div class="lg:col-span-7">
            {item.layout === 'web' ? (
              <DeviceFrame
                src={item.images[0].src}
                alt={item.images[0].alt}
                width={item.images[0].width}
                height={item.images[0].height}
                urlLabel={item.liveUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '')}
              />
            ) : (
              <div class="grid grid-cols-3 gap-3 border border-rule bg-paper p-3 sm:p-4" dir="ltr">
                {item.images.map((img) => (
                  <div class="overflow-hidden border border-rule bg-paper-alt">
                    <img
                      src={withBase(img.src)}
                      alt={img.alt}
                      width={img.width}
                      height={img.height}
                      loading="lazy"
                      decoding="async"
                      class="block h-auto w-full object-cover"
                    />
                  </div>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ══ 03 · COMPLETE WORK INDEX ═════════════════════════════════════════════ -->
<section class="container-swiss py-16 md:py-20">
  <div class="flex flex-wrap items-end justify-between gap-4 border-b border-ink pb-5">
    <div>
      <p class="meta-label">03 / {lang === 'en' ? 'Archive · 2021–2026' : 'سجل الأعمال · 2021–2026'}</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {lang === 'en' ? 'Index of Shipped Systems' : 'فهرس الأنظمة والمشاريع'}
      </h2>
    </div>
    <a href={withBase(`${prefix}/work/`)} class="btn-quiet">
      {lang === 'en' ? 'Filter by domain' : 'تصفية حسب المجال'} {arrow}
    </a>
  </div>

  <div class="mt-4 overflow-x-auto">
    <table class="w-full border-collapse text-start text-sm">
      <thead>
        <tr class="border-b border-ink font-mono text-[11px] uppercase tracking-wider text-ink-muted">
          <th class="py-3 pe-4 text-start font-medium">{lang === 'en' ? 'Year' : 'السنة'}</th>
          <th class="py-3 pe-4 text-start font-medium">{lang === 'en' ? 'System' : 'النظام'}</th>
          <th class="hidden py-3 pe-4 text-start font-medium md:table-cell">{lang === 'en' ? 'Domain' : 'المجال'}</th>
          <th class="hidden py-3 pe-4 text-start font-medium lg:table-cell">{lang === 'en' ? 'Engineering Outcome' : 'المخرج الهندسي'}</th>
          <th class="py-3 text-end font-medium">{lang === 'en' ? 'Proof' : 'الدليل'}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-rule">
        {WORK_INDEX.map((row) => (
          <tr class="transition-colors hover:bg-paper-alt/80">
            <td class="tabular-nums py-3.5 pe-4 font-mono text-xs text-ink-muted whitespace-nowrap">
              {row.year}
            </td>
            <td class="py-3.5 pe-4 font-medium text-ink">
              {row.name[lang]}
              <span class="mt-0.5 block text-xs font-normal text-ink-muted lg:hidden">
                {row.outcome[lang]}
              </span>
            </td>
            <td class="hidden py-3.5 pe-4 font-mono text-xs text-ink-muted whitespace-nowrap md:table-cell">
              {row.domain[lang]}
            </td>
            <td class="hidden py-3.5 pe-4 text-ink-soft lg:table-cell">
              {row.outcome[lang]}
            </td>
            <td class="py-3.5 text-end font-mono text-xs whitespace-nowrap">
              <div class="inline-flex items-center justify-end gap-3">
                {row.caseStudySlug && (
                  <a
                    href={withBase(
                      lang === 'ar' && (row.caseStudySlug === 'hawyati' || row.caseStudySlug === 'magic-linker')
                        ? `/ar/work/${row.caseStudySlug}/`
                        : `/work/${row.caseStudySlug}/`,
                    )}
                    class="text-accent underline hover:text-accent-dark"
                  >
                    {lang === 'en' ? 'Case Study' : 'الدراسة'}
                  </a>
                )}
                {row.liveUrl && (
                  <a href={row.liveUrl} target="_blank" rel="noopener noreferrer" class="text-ink underline hover:text-accent">
                    {lang === 'en' ? 'Live ↗' : 'مباشر ↗'}
                  </a>
                )}
                {row.playStoreUrl && (
                  <a href={row.playStoreUrl} target="_blank" rel="noopener noreferrer" class="text-ink underline hover:text-accent">
                    Play ↗
                  </a>
                )}
                {!row.liveUrl && !row.playStoreUrl && !row.caseStudySlug && (
                  <span class="text-ink-muted">NDA</span>
                )}
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<!-- ══ 04 · STACK I SHIP WITH (NO PERCENTAGE BARS) ══════════════════════════ -->
<section class="border-t border-rule py-16 md:py-20">
  <div class="container-swiss">
    <div class="border-b border-ink pb-5">
      <p class="meta-label">04 / {lang === 'en' ? 'Capabilities Tied to Proof' : 'تقنيات مرتبطة بمشاريع فعلية'}</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {lang === 'en' ? 'Stack I Ship In Production' : 'التقنيات التي أشحن بها أنظمة إنتاجية'}
      </h2>
    </div>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {STACK_GROUPS.map((group) => (
        <div class="border border-rule bg-paper-alt/50 p-6">
          <h3 class="border-b border-rule pb-3 font-mono text-xs font-semibold uppercase tracking-wider text-ink">
            {group.area[lang]}
          </h3>
          <ul class="mt-4 space-y-4">
            {group.items.map((item) => (
              <li>
                <p class="font-medium text-ink" dir="ltr">{item.tech}</p>
                <p class="mt-0.5 text-sm text-ink-muted">{item.shippedIn[lang]}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══ 05 · OPEN SOURCE (GITHUB) ════════════════════════════════════════════ -->
<section class="border-t border-rule bg-paper-alt/45 py-16 md:py-20">
  <div class="container-swiss">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-ink pb-5">
      <div>
        <p class="meta-label">05 / {lang === 'en' ? 'Public Code' : 'كود مفتوح المصدر'}</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
          {lang === 'en' ? 'Selected GitHub Repositories' : 'مشاريع مختارة على GitHub'}
        </h2>
      </div>
      <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="btn-quiet">
        github.com/Ibrahem-Khaled ↗
      </a>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {OPEN_SOURCE_REPOS.map((repo) => (
        <a
          href={repo.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col justify-between border border-rule bg-paper p-5 transition-colors hover:border-ink"
        >
          <div>
            <div class="flex items-start justify-between gap-2" dir="ltr">
              <h3 class="font-mono text-sm font-semibold text-ink group-hover:text-accent">
                {repo.name}
              </h3>
              <span class="font-mono text-xs text-ink-muted group-hover:text-accent">↗</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">
              {repo.summary[lang]}
            </p>
          </div>
          <p class="mt-4 border-t border-rule pt-3 font-mono text-[11px] text-ink-muted" dir="ltr">
            {repo.stack}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ══ 06 · PRINCIPLES & CLIENT FEEDBACK ════════════════════════════════════ -->
<section class="container-swiss py-16 md:py-20">
  <div class="border-b border-ink pb-5">
    <p class="meta-label">06 / {lang === 'en' ? 'How I Work' : 'أسلوب العمل الهندسي'}</p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {lang === 'en' ? 'Engineering Principles' : 'مبادئ ألتزم بها في كل نظام'}
    </h2>
  </div>

  <div class="mt-10 grid gap-8 md:grid-cols-3">
    {PRINCIPLES.map((p) => (
      <div class="border-t-2 border-ink pt-5">
        <span class="font-mono text-xs font-semibold text-accent">{p.num}</span>
        <h3 class="mt-2 text-lg font-semibold text-ink">{p.title[lang]}</h3>
        <p class="mt-2.5 text-sm leading-relaxed text-ink-soft">{p.body[lang]}</p>
      </div>
    ))}
  </div>

  <!-- Client Quotes -->
  <div class="mt-20 border-t border-rule pt-14">
    <p class="meta-label">{lang === 'en' ? 'Client Feedback (Mostaql & Direct Engagements)' : 'آراء عملاء (مستقل وتعاقدات مباشرة)'}</p>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {CLIENT_QUOTES.map((q) => (
        <blockquote class="flex flex-col justify-between border border-rule bg-paper-alt/50 p-6">
          <p class="text-sm leading-relaxed text-ink">“{q.quote[lang]}”</p>
          <footer class="mt-5 border-t border-rule pt-3 text-xs">
            <span class="font-semibold text-ink">{q.author[lang]}</span>
            <span class="block text-ink-muted">{q.context[lang]}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<!-- ══ 07 · DUAL AUDIENCE CTA (RECRUITERS + FREELANCE) ══════════════════════ -->
<section class="container-swiss pb-6">
  <div class="grid gap-6 border-2 border-ink bg-paper-alt p-6 sm:p-10 md:grid-cols-2">
    <div class="border-b border-rule pb-6 md:border-b-0 md:border-e md:pb-0 md:pe-8">
      <p class="meta-label">{lang === 'en' ? 'Path A · Engineering Teams' : 'المسار الأول · شركات وفرق تقنية'}</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink">
        {lang === 'en' ? 'Hiring a Senior Full-Stack Engineer?' : 'تبحث عن مهندس Senior للعمل عن بُعد؟'}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-soft">
        {lang === 'en'
          ? '5 years across Laravel, Node.js, React, React Native & AI integrations. Remote from Egypt (UTC+2) with strong overlap for EU, UK & Gulf teams.'
          : 'خبرة 5 سنوات في Laravel وNode.js وReact وReact Native وتكاملات الذكاء الاصطناعي. عمل عن بُعد من مصر بتوقيت متوافق تماماً مع الخليج وأوروبا.'}
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={withBase(PROFILE.cvPath)} download="Ibrahim_Khaled_CV.pdf" class="btn-primary">
          {lang === 'en' ? 'Download CV (PDF) ↓' : 'تحميل السيرة الذاتية ↓'}
        </a>
        <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          LinkedIn ↗
        </a>
      </div>
    </div>

